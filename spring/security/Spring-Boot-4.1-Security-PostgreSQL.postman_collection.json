{
  "info": {
    "_postman_id": "98e8f0bf-a39a-49ff-9a47-6fdf8f741410",
    "name": "Spring Boot 4.1 Security + PostgreSQL JWT",
    "description": "Postman collection for Spring Boot 4.1.0, Spring Security 7, PostgreSQL and JWT role-based authorization. Run signup once, then signin. Signin requests automatically store JWTs in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [],
